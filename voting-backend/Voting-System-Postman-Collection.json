{
	"info": {
		"_postman_id": "0df6e88e-c3bd-4d56-b072-0051187d99be",
		"name": "Online Voting System",
		"description": "API Collection for the Online Voting System Backend",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. View Candidates",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "http://localhost:8080/api/candidates",
					"protocol": "http",
					"host": [
						"localhost"
					],
					"port": "8080",
					"path": [
						"api",
						"candidates"
					]
				},
				"description": "Fetch the list of all candidates publicly."
			},
			"response": []
		},
		{
			"name": "2. Login",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"var jsonData = pm.response.json();",
							"pm.environment.set(\"jwt_token\", jsonData.token);"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\r\n  \"username\": \"student1\",\r\n  \"password\": \"password123\"\r\n}"
				},
				"url": {
					"raw": "http://localhost:8080/api/auth/login",
					"protocol": "http",
					"host": [
						"localhost"
					],
					"port": "8080",
					"path": [
						"api",
						"auth",
						"login"
					]
				},
				"description": "Login to receive JWT token. This automatically saves the `jwt_token` to your Postman environment for the Cast Vote request."
			},
			"response": []
		},
		{
			"name": "3. Cast Vote",
			"request": {
				"auth": {
					"type": "bearer",
					"bearer": [
						{
							"key": "token",
							"value": "{{jwt_token}}",
							"type": "string"
						}
					]
				},
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\r\n  \"candidateId\": 1\r\n}"
				},
				"url": {
					"raw": "http://localhost:8080/api/votes",
					"protocol": "http",
					"host": [
						"localhost"
					],
					"port": "8080",
					"path": [
						"api",
						"votes"
					]
				},
				"description": "Cast a vote. Requires JWT token from Login."
			},
			"response": []
		},
		{
			"name": "4. View Results",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "http://localhost:8080/api/results",
					"protocol": "http",
					"host": [
						"localhost"
					],
					"port": "8080",
					"path": [
						"api",
						"results"
					]
				},
				"description": "Fetch the total vote counts per candidate."
			},
			"response": []
		}
	]
}
